# === GymPOS .gitignore ===

# Python venv
.venv/

# Data files / secrets
gym.db
gym.db-shm
gym.db-wal
.env
backups/
static/backups/

# Face captures / privacy
static/photos/
static/clips/

# Compiled caches (general)
__pycache__/
*.pyc

# Essential compiled app modules — no .py source exists; required to run
!main.pyc
!config.pyc
!paths.pyc
!template_helpers.pyc
!database/*.pyc
!routers/*.pyc
!services/*.pyc

# Debug artifacts / disassembly output
*_disasm.txt
*_disasm.log

# One-shot scripts with hardcoded paths (should not be tracked)
add_attendance_indexes.py
check_plan.py

# Electron
electron/node_modules/
electron/GymPOS.exe.bak
electron/node_modules/electron/dist/GymPOS_Data/

# ESP32 build artifacts
esp32/.pio/

# Binaries
GymPOS.exe

# OS / editor junk
Thumbs.db
Desktop.ini
Microsoft Edge.lnk
.opencode/
opencode.json
opencode.bat
opencode.cmd
opencode.ps1
