# GymPOS hardware configuration — copy to .env and adjust
# This file is machine-specific and intentionally NOT committed

# Cameras (USB device indices) — 3 cams: In/Out/Tailgate
CAM1_INDEX=1
CAM2_INDEX=0
CAM3_INDEX=2

# Serial
SERIAL_PORT=COM3
SERIAL_BAUD=115200

# Face recognition tolerance (lower = stricter)
FACE_TOLERANCE=0.36

# App
SOLO_PORT=8000
SOLO_DATA_DIR=./GymPOS_Data
SECRET_KEY=change-me-generate-with-python-c-secrets-token-urlsafe-32

# Lock type: solenoid (default) or maglock (magnetic lock, invert logic)
LOCK_TYPE=maglock
