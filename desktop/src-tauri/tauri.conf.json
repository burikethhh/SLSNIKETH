{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GymPOS",
  "version": "0.1.0",
  "identifier": "com.gympos.app",
  "build": {
    "frontendDist": "../webview"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GymPOS Access & Management",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "fullscreen": false,
        "resizable": true,
        "center": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://gympos-cloud.onrender.com http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../models/*",
      "../../../gympos-saas/bin/gympos_local.sqlite"
    ],
    "nsis": {
      "displayLanguageSelector": false,
      "installerIcon": "icons/icon.ico",
      "headerImage": "icons/128x128.png",
      "sidebarImage": "icons/128x128@2x.png",
      "installMode": "perMachine",
      "languages": ["English"],
      "shortcuts": [
        {
          "id": "gympos-desktop",
          "target": "{INSTALL_DIR}\\GymPOS.exe",
          "name": "GymPOS",
          "workingDirectory": "{INSTALL_DIR}",
          "desktop": true,
          "startMenu": "GymPOS"
        }
      ],
      "template": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/burikethhh/SLSNIKETH/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5NjY3ODBGNzIzOTNCNzMKUldSek96bHlEM2hteVZtaTdzQjI1c3FDS1RYSkNOSitxSlB5WG40czBQUC81dEVXamdGOWtrRUoK"
    }
  }
}
